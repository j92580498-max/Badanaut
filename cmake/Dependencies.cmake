include_guard(GLOBAL)

get_filename_component(BADANAUT_THIRD_PARTY "${CMAKE_CURRENT_LIST_DIR}/../third_party" ABSOLUTE)

function(badanaut_require_submodule name source)
    if(NOT EXISTS "${BADANAUT_THIRD_PARTY}/${name}/${source}")
        message(FATAL_ERROR
            "Missing ${name} submodule. From the repository root, run "
            "git submodule update --init --recursive, or clone with git clone --recurse-submodules.")
    endif()
endfunction()

function(badanaut_add_sdl)
    if(TARGET bada-sdl)
        return()
    endif()
    badanaut_require_submodule(SDL2 CMakeLists.txt)
    set(SDL_SHARED ON CACHE BOOL "" FORCE)
    set(SDL_STATIC OFF CACHE BOOL "" FORCE)
    set(SDL_TEST OFF CACHE BOOL "" FORCE)
    set(SDL_TESTS OFF CACHE BOOL "" FORCE)
    set(SDL2_DISABLE_INSTALL ON CACHE BOOL "" FORCE)
    add_subdirectory("${BADANAUT_THIRD_PARTY}/SDL2" "${CMAKE_BINARY_DIR}/deps/SDL2")

    # The engine uses SDL2/SDL.h; upstream build targets export the leaf directory.
    set(compat_include "${CMAKE_BINARY_DIR}/include_compat")
    file(COPY "${BADANAUT_THIRD_PARTY}/SDL2/include/" DESTINATION "${compat_include}/SDL2")
    add_library(bada-sdl INTERFACE)
    target_include_directories(bada-sdl INTERFACE "${compat_include}")
    target_link_libraries(bada-sdl INTERFACE SDL2::SDL2)
endfunction()

function(badanaut_add_unicorn)
    if(TARGET unicorn)
        return()
    endif()
    badanaut_require_submodule(unicorn CMakeLists.txt)
    # Bada guests are ARM32 on every host, including Android ARM64.
    set(BUILD_SHARED_LIBS ON)
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    set(UNICORN_ARCH "arm" CACHE STRING "" FORCE)
    set(UNICORN_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(UNICORN_INSTALL OFF CACHE BOOL "" FORCE)
    set(UNICORN_LEGACY_STATIC_ARCHIVE OFF CACHE BOOL "" FORCE)
    add_subdirectory("${BADANAUT_THIRD_PARTY}/unicorn" "${CMAKE_BINARY_DIR}/deps/unicorn")
    if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8)
        include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/UnicornWindows.cmake")
        badanaut_patch_unicorn_windows()
    endif()
    if(ANDROID)
        # SDL loads libunicorn.so by name, without a versioned Linux SONAME.
        set_target_properties(unicorn PROPERTIES VERSION "" SOVERSION "")
        foreach(target unicorn unicorn-common arm-softmmu)
            target_compile_options(${target} PRIVATE -O2)
        endforeach()
    endif()
endfunction()

function(badanaut_add_support_libraries)
    if(TARGET bada-tlsf)
        return()
    endif()
    badanaut_require_submodule(pugixml src/pugixml.cpp)
    badanaut_require_submodule(cxxopts include/cxxopts.hpp)
    badanaut_require_submodule(tlsf tlsf.c)
    badanaut_require_submodule(pvr framework/PVRCore/texture/PVRTDecompress.cpp)
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)

    add_library(bada-pugixml STATIC "${BADANAUT_THIRD_PARTY}/pugixml/src/pugixml.cpp")
    target_include_directories(bada-pugixml PUBLIC "${BADANAUT_THIRD_PARTY}/pugixml/src")
    add_library(bada-cxxopts INTERFACE)
    target_include_directories(bada-cxxopts INTERFACE "${BADANAUT_THIRD_PARTY}/cxxopts/include")
    add_library(bada-tlsf STATIC "${BADANAUT_THIRD_PARTY}/tlsf/tlsf.c")
    target_include_directories(bada-tlsf PUBLIC "${BADANAUT_THIRD_PARTY}/tlsf")

    # Use only the upstream texture decoder, without building the PowerVR SDK.
    set(pvr_texture_dir "${BADANAUT_THIRD_PARTY}/pvr/framework/PVRCore/texture")
    add_library(bada-pvr STATIC "${pvr_texture_dir}/PVRTDecompress.cpp")
    target_include_directories(bada-pvr PUBLIC "${pvr_texture_dir}")
    if(ANDROID)
        target_compile_options(bada-tlsf PRIVATE -O2)
        target_compile_options(bada-pvr PRIVATE -O2)
    endif()
endfunction()

function(badanaut_add_sdl_image)
    if(TARGET SDL2_image::SDL2_image)
        return()
    endif()
    badanaut_require_submodule(SDL2_image CMakeLists.txt)
    badanaut_add_sdl()
    set(BUILD_SHARED_LIBS ON)
    set(SDL2IMAGE_INSTALL OFF CACHE BOOL "" FORCE)
    set(SDL2IMAGE_SAMPLES OFF CACHE BOOL "" FORCE)
    set(SDL2IMAGE_TESTS OFF CACHE BOOL "" FORCE)
    # Screenshots need the built-in PNG/JPEG encoders, without system codec DLLs.
    set(SDL2IMAGE_BACKEND_STB ON CACHE BOOL "" FORCE)
    set(SDL2IMAGE_AVIF OFF CACHE BOOL "" FORCE)
    set(SDL2IMAGE_JXL OFF CACHE BOOL "" FORCE)
    set(SDL2IMAGE_TIF OFF CACHE BOOL "" FORCE)
    set(SDL2IMAGE_WEBP OFF CACHE BOOL "" FORCE)
    add_subdirectory("${BADANAUT_THIRD_PARTY}/SDL2_image" "${CMAKE_BINARY_DIR}/deps/SDL2_image")
    set_target_properties(SDL2_image PROPERTIES BUILD_RPATH "$ORIGIN" INSTALL_RPATH "$ORIGIN")
    file(COPY "${BADANAUT_THIRD_PARTY}/SDL2_image/include/SDL_image.h"
        DESTINATION "${CMAKE_BINARY_DIR}/include_compat/SDL2")
endfunction()

function(badanaut_add_nuklear)
    if(TARGET bada-nuklear)
        return()
    endif()
    badanaut_require_submodule(nuklear nuklear.h)
    add_library(bada-nuklear INTERFACE)
    target_include_directories(bada-nuklear INTERFACE
        "${BADANAUT_THIRD_PARTY}/nuklear"
        "${BADANAUT_THIRD_PARTY}/nuklear/demo/sdl_opengl2")
endfunction()

function(badanaut_add_audio_decoders)
    if(TARGET bada-audio-decoders)
        return()
    endif()
    badanaut_require_submodule(dr_libs dr_mp3.h)
    badanaut_require_submodule(dr_libs dr_wav.h)
    add_library(bada-audio-decoders STATIC "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/audio_decoders.c")
    set_target_properties(bada-audio-decoders PROPERTIES POSITION_INDEPENDENT_CODE ON)
    target_include_directories(bada-audio-decoders PUBLIC "${BADANAUT_THIRD_PARTY}/dr_libs")
    target_compile_definitions(bada-audio-decoders PUBLIC DR_MP3_NO_STDIO DR_WAV_NO_STDIO)
    if(ANDROID)
        target_compile_options(bada-audio-decoders PRIVATE -O2)
    endif()
endfunction()
